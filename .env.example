# Скопируйте этот файл в .env (PowerShell: copy .env.example .env). Файл .env в git не попадает.
# Для запуска через Docker менять ничего НЕ обязательно: у всего есть рабочие значения по умолчанию.
# После правки .env примените изменения:  docker compose up -d

# ---------------------------------------------------------------- Первый администратор
# Если задать пароль здесь, `docker compose up -d` сам создаст администратора при первом запуске.
# Создаётся только если в БД ещё нет активного admin; пароль существующего пользователя НИКОГДА не перезаписывается.
# Не задан — ничего страшного: выполните `docker compose run --rm bootstrap`, он спросит логин и пароль.
# Требования: логин — латиница/цифры, 3–64 символа; пароль — от 8 символов, не из списка типичных (password, 12345678 …).
# Символ $ в пароле пишите как $$ (иначе Compose примет его за переменную). После создания пароль отсюда можно удалить.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------- PostgreSQL (в Docker)
# ВАЖНО: пользователь, пароль и имя БД применяются только при ПЕРВОМ создании тома pgdata. Потом смена здесь БД не
# изменит, и приложение перестанет подключаться. Пароль — без символов @ : / ? # % (он вставляется в URL подключения).
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=postgres
#POSTGRES_DB=shelf_audit

# ---------------------------------------------------------------- Порты на вашем компьютере
# Меняйте, если порт занят (ошибка «port is already allocated» / «address already in use»).
#API_PORT=8000
# Административный вход (управление, решение В-1, документ 18): только на 127.0.0.1 и, после настройки VPN, на адресе VPN.
#ADMIN_PORT=8001
# Порт входа покупателя (адрес в QR-коде магазина, решение D-07): только «Узнать товар» без входа.
#SHOP_PORT=8080
# Адрес этого компьютера в VPN-сети (Tailscale 100.x.y.z, WireGuard 10.x.x.x). Нужен только для docker-compose.vpn.yml.
#VPN_BIND_IP=
# Другие имена административного входа через запятую (например, имя компьютера в Tailscale: shop-pc.tailnet-name.ts.net).
# По имени не из списка программа откроется, но без прав управления (защита от подмены DNS, документ 18, §12).
#ADMIN_ALLOWED_HOSTS=
# Защищённый адрес для сотрудников в сети магазина (HTTPS: scripts/make_local_tls.py и docker-compose.https.yml, документ 18, §14).
# Страница покажет его вместо входа по HTTP. Пример: PUBLIC_HTTPS_URL=https://192.168.1.10:8000
#PUBLIC_HTTPS_URL=
#DB_PORT=5432
#REDIS_PORT=6379

# ---------------------------------------------------------------- Время
# Часовой пояс для отображения времени в админ-панели.
#APP_TIMEZONE=Asia/Tashkent
# Если в вашем .env есть CAMERA_SECRET_KEY — НЕ УДАЛЯЙТЕ его: им зашифрованы адреса камер, сохранённые в базе данных
# (камеры из приложения убраны, но данные остались). docker-compose этот ключ в контейнеры больше не передаёт.

# ---------------------------------------------------------------- Вход: второй фактор (2FA) и сеансы (документ 18)
# Секрет сервера для входа: шифрует секреты приложений-аутентификаторов в базе. Без него вход по паролю работает как раньше,
# но второй фактор включить нельзя. Создать: docker compose exec api python -m scripts.generate_secret_key --auth
# Сохраните ключ отдельно от базы и копий (менеджер паролей): потеряете — включённые вторые факторы придётся сбросить
# (docker compose exec api python -m scripts.user_admin reset-2fa --username ЛОГИН) и настроить заново.
#AUTH_SECRET_KEY=

# Счётчик неудачных попыток входа: auto (по умолчанию) — один общий в Redis очереди для всех входов программы (порты 8000 и 8001,
# VPN); memory — свой в памяти каждого процесса. Если Redis недоступен, счёт сам переходит в память — вход не ломается.
#AUTH_THROTTLE_BACKEND=auto

# ---------------------------------------------------------------- Приложение
# production: отключает /docs и /redoc (карта эндпоинтов). Для локального пилота оставьте development.
#ENVIRONMENT=development
# Кому браузер разрешено ходить в API с ДРУГОГО адреса (CORS), через запятую. Страницам проекта (http://<сервер>:8000/ui/...)
# это не нужно — они ходят на тот же адрес. Нужно только страницам, открытым как файл с диска, или размещённым на другом адресе.
# Пусто: development — любой источник; production — кросс-доменный доступ закрыт. Пример:
#   CORS_ALLOW_ORIGINS=https://audit.example.com,http://192.168.1.50:8000     (без пути после адреса; «*» — любой)
#CORS_ALLOW_ORIGINS=
# Максимальный размер одного снимка, МБ.
#MAX_UPLOAD_MB=25
# 1 = разрешить СЛУЧАЙНЫЕ эмбеддинги, если модель DINOv2 не скачалась (нет интернета). Результаты распознавания
# при этом бессмысленны — только чтобы проверить остальную систему. Для работы оставьте 0.
#ALLOW_DEBUG_EMBEDDER=0
# 1 = разрешить ЭВРИСТИЧЕСКИЙ детектор контуров, если YOLO не загрузился (нет файла models/detector/sku110k_yolo11n.pt).
# Только демо: на реальных полках он ненадёжен. По умолчанию (0) воркер без YOLO НЕ стартует и пишет причину в лог.
#ALLOW_HEURISTIC_DETECTOR=0
# Срок жизни токена входа, минуты (по умолчанию 720 = 12 часов, см. configs/config.yaml).
#AUTH_TOKEN_TTL_MINUTES=720

# ---------------------------------------------------------------- Только для запуска БЕЗ Docker-образа
# (python -m scripts.start_demo: API и воркер в venv на Windows, Postgres и Redis — из Docker). В контейнерах эти две
# переменные задаёт docker-compose.yml и значения отсюда игнорируются. Умолчания совпадают с примером ниже.
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shelf_audit
#QUEUE_BROKER_URL=redis://localhost:6379/0
